          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{A0ADBD27-8B44-42C6-9970-393B43EB5940}</string>
          <BinaryString name="SerializedOverrides">
            </BinaryString>
          <string name="Source">local player = game.Players.LocalPlayer
local cashLabel = script.Parent:WaitForChild("CashLabel")

local leaderstats = player:WaitForChild("leaderstats")
local cash = leaderstats:WaitForChild("Cash")

local function formatNumber(number)
	local formatted = tostring(number)

	while true do
		local newFormatted, replacements =
			formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")

		formatted = newFormatted

		if replacements == 0 then
			break
		end
	end

	return formatted
end

local function updateCash()
	cashLabel.Text = "CASH: $" .. formatNumber(cash.Value)
end

updateCash()

cash:GetPropertyChangedSignal("Value"):Connect(updateCash)</string>
          <int64 name="SourceAssetId">-1</int64>
